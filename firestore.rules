rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cualquiera con el enlace puede ver y cambiar lotes, pero solo con datos válidos.
    match /lotes/{loteId} {
      allow read, delete: if true;
      allow create, update: if esLoteValido(request.resource.data);
    }
    // Todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
  function esLoteValido(d) {
    return d.keys().hasOnly(['plaza', 'codigo', 'cartones', 'fechaRegistro', 'despachado', 'fechaDespacho', 'pagado', 'fechaPago'])
      && d.plaza is string && d.plaza.size() > 0 && d.plaza.size() <= 120
      && d.codigo is string && d.codigo.size() > 0 && d.codigo.size() <= 120
      && d.cartones is int && d.cartones > 0 && d.cartones <= 10000000
      && d.fechaRegistro is string && d.fechaRegistro.size() <= 40
      && d.despachado is bool && d.pagado is bool
      && (d.fechaDespacho == null || (d.fechaDespacho is string && d.fechaDespacho.size() <= 10))
      && (d.fechaPago == null || (d.fechaPago is string && d.fechaPago.size() <= 10));
  }
}
