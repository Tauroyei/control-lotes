rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }
    function rutaUsuario(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }
    function rutaSetup() {
      return /databases/$(database)/documents/config/setup;
    }
    // Solo entra quien tiene un perfil en usuarios/{uid} marcado como activo.
    function activo() {
      return conSesion() && exists(rutaUsuario(request.auth.uid))
        && get(rutaUsuario(request.auth.uid)).data.activo == true;
    }
    function esAdmin() {
      return activo() && get(rutaUsuario(request.auth.uid)).data.rol == 'admin';
    }

    // Marca que ya se creó el primer administrador. Se crea una sola vez, junto con su perfil.
    match /config/setup {
      allow get: if true;
      allow create: if conSesion() && !exists(rutaSetup())
        && getAfter(rutaUsuario(request.auth.uid)).data.rol == 'admin'
        && request.resource.data.keys().hasOnly(['creadoEn']);
      allow update, delete: if false;
    }

    match /usuarios/{uid} {
      allow get: if conSesion() && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();
      allow create: if usuarioValido(request.resource.data) && (
        // Un administrador crea usuarios para otras personas.
        (esAdmin() && uid != request.auth.uid) ||
        // Configuración inicial: el primer usuario se crea a sí mismo como administrador.
        (conSesion() && request.auth.uid == uid && !exists(rutaSetup()) && existsAfter(rutaSetup())
          && request.resource.data.rol == 'admin' && request.resource.data.activo == true)
      );
      // El administrador cambia rol y estado de los demás (no el suyo, para no quedarse sin acceso).
      allow update: if esAdmin() && uid != request.auth.uid && usuarioValido(request.resource.data)
        && request.resource.data.usuario == resource.data.usuario;
      allow delete: if false;
    }

    match /plazas/{plazaId} {
      allow read: if activo();
      allow create, update: if esAdmin() && plazaValida(request.resource.data);
      allow delete: if esAdmin();
    }

    match /lotes/{loteId} {
      allow read: if activo();
      // Todo lote nuevo entra sin despachar y sin pagar.
      allow create: if activo() && loteValido(request.resource.data)
        && request.resource.data.despachado == false && request.resource.data.fechaDespacho == null
        && request.resource.data.pagado == false && request.resource.data.fechaPago == null;
      // El administrador cambia cualquier dato; un operador solo marca o deshace el despacho de un lote sin pagar.
      allow update: if loteValido(request.resource.data) && (
        esAdmin() ||
        (activo() && resource.data.pagado == false && request.resource.data.pagado == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['despachado', 'fechaDespacho']))
      );
      allow delete: if esAdmin();
    }

    // Todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function usuarioValido(d) {
    return d.keys().hasOnly(['usuario', 'rol', 'activo', 'creadoEn'])
      && d.usuario is string && d.usuario.matches('^[a-z0-9._-]{3,30}$')
      && d.rol in ['admin', 'operador']
      && d.activo is bool
      && (!('creadoEn' in d) || (d.creadoEn is string && d.creadoEn.size() <= 40));
  }

  function plazaValida(d) {
    return d.keys().hasOnly(['nombre', 'creadaEn'])
      && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
      && (!('creadaEn' in d) || (d.creadaEn is string && d.creadaEn.size() <= 40));
  }

  function loteValido(d) {
    return d.keys().hasOnly(['plaza', 'codigo', 'cartones', 'fechaRegistro', 'despachado', 'fechaDespacho', 'pagado', 'fechaPago', 'creadoPor'])
      && d.plaza is string && d.plaza.size() > 0 && d.plaza.size() <= 120
      && d.codigo is string && d.codigo.size() > 0 && d.codigo.size() <= 120
      && d.cartones is int && d.cartones > 0 && d.cartones <= 10000000
      && d.fechaRegistro is string && d.fechaRegistro.size() <= 40
      && d.despachado is bool && d.pagado is bool
      && (d.fechaDespacho == null || (d.fechaDespacho is string && d.fechaDespacho.size() <= 10))
      && (d.fechaPago == null || (d.fechaPago is string && d.fechaPago.size() <= 10))
      && (!('creadoPor' in d) || (d.creadoPor is string && d.creadoPor.size() <= 120));
  }
}
